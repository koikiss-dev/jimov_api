{
  "name": "jimov_scraper",
  "version": "1.0.0",
  "packageManager": "pnpm@11.23.0",
  "description": "API for scraping multimedia content such as anime, movies, series, and manga",
  "main": "src/index.ts",
  "scripts": {
    "start": "node ./build/src/index.js",
    "start:pm2": "pm2 start ./build/src/index.js",
    "server": "nodemon src/index.ts",
    "start:vercel": "node build/index.js",
    "format": "prettier --ignore-path .gitignore --write \"**/*.+(js|ts|json)\"",
    "linter": "npx eslint src/scraper/* src/routes/*",
    "linter:win": "npx eslint src/scraper/** src/routes/**",
    "build": "tsc && tsc-alias",
    "start:dev": "nodemon src/index.ts",
    "test": "jest --coverage"
  },
  "pre-commit": [
    "ts.check",
    "build",
    "add-build"
  ],
  "keywords": [
    "scraper",
    "api",
    "multimedia",
    "anime",
    "doramas",
    "movies",
    "series",
    "manga"
  ],
  "commitlint": {
    "extends": "@commitlint/config-conventional"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/koikiss-dev/jimov_api"
  },
  "homepage": "https://github.com/koikiss-dev/jimov_api",
  "dependencies": {
    "@types/cheerio": "^0.22.35",
    "axios": "^1.19.0",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "crypto-js": "^4.2.0",
    "express": "^4.22.2",
    "helmet": "^6.2.0",
    "morgan": "^1.11.0",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.17",
    "tsconfig-paths": "^4.2.0",
    "underscore": "^1.13.8",
    "unpacker": "^1.0.1"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^17.8.1",
    "@tsconfig/recommended": "^1.0.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jest": "^29.5.14",
    "@types/morgan": "^1.9.10",
    "@types/node": "^18.19.130",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "commitlint": "^17.8.1",
    "dotenv": "^16.6.1",
    "eslint": "^8.57.1",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "npm-check-updates": "^16.14.20",
    "prettier": "^3.8.3",
    "pretty": "^2.0.0",
    "ts-jest": "^29.4.11",
    "tslib": "^2.8.1",
    "typescript": "^4.9.5"
  }
}
